{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "espidf",
      "request": "launch",
      "name": "ESP-IDF Debug: Launch",
      "target": "esp32c6",
      "port": "/dev/cu.usbmodem21201",
      "openOcdConfig": "${command:espIdf.getOpenOcdScriptValue}",
      "program": "${workspaceFolder}/build/hello_world.elf",
      "gdbPath": "${env:IDF_TOOLS_PATH}/tools/riscv32-esp-elf/<version>/bin/riscv32-esp-elf-gdb",
      "esp-idf.pythonBinPath": "/Users/david/.espressif/python_env/idf6.0_py3.12_env/bin/python",
      "cwd": "${workspaceFolder}",
      "env": {},
      "initBreak": "main",
      "registers": {
        "showPeripheralRegisters": true
      },

    }
  ]
}
